<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/menuCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/less_menu_card_margin"
        android:layout_marginEnd="@dimen/less_menu_card_margin"
        android:orientation="vertical"
        android:background="@drawable/less_menu_card"
        android:clickable="true"
        android:focusable="true"
        android:elevation="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/less_menu_card_max_height"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/menuList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/less_menu_card_pad"
                android:paddingEnd="@dimen/less_menu_card_pad"
                android:paddingTop="@dimen/less_menu_card_pad"
                android:paddingBottom="@dimen/less_menu_card_pad" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
