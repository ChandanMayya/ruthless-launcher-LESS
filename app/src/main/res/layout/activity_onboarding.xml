<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/less_black"
    android:padding="@dimen/less_onboarding_outer_pad">

    <LinearLayout
        android:id="@+id/onboardingFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/less_onboarding_frame"
        android:orientation="vertical"
        android:paddingStart="@dimen/less_onboarding_inner_pad"
        android:paddingEnd="@dimen/less_onboarding_inner_pad"
        android:paddingTop="@dimen/less_onboarding_inner_pad"
        android:paddingBottom="@dimen/less_onboarding_inner_pad">

        <TextView
            android:id="@+id/onboardingStep"
            style="@style/LessText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="1 / 6"
            android:contentDescription="Setup step" />

        <View
            style="@style/LessDivider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/onboardingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
